+        for (mode, space, keys, label) in [
+            ("rgb", ToneSpace::Rgb, vec!["", "red", "blue"], "RB"),
+            ("cmyk", ToneSpace::Cmyk, vec!["", "cyan", "yellow"], "CY"),
+            ("lab", ToneSpace::Lab, vec!["", "lightness", "b"], "Lb"),
+        ] {
+            let cx = context(mode);
