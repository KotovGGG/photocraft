+/// The native-source digest cache keys by allocation without keeping sources alive, never
+/// returns a digest for different bytes, and stays within its capacity.
+#[test]
+fn native_digest_cache_is_bounded_weak_and_never_stale() {
+    let mut cache = NativeDigests::new(4);
+    let source = Arc::new(b"%PDF-1.7\nfirst".to_vec());
+    let digest = *blake3::hash(&source).as_bytes();
+    assert_eq!(cache.get(&source), None);
+    cache.insert(&source, digest);
+    assert_eq!(cache.get(&source), Some(digest));
+    assert_eq!(Arc::strong_count(&source), 1, "the cache must not own the source");
+    // Equal bytes in another allocation are a different identity: verified separately.
+    let copy = Arc::new(source.as_ref().clone());
+    assert_eq!(cache.get(&copy), None);
+    // A dropped source's entry is pruned; a new source of the same length is never served
+    // the old digest, even if the allocator reuses the buffer.
+    drop(copy);
+    let address = Arc::as_ptr(&source);
+    drop(source);
+    let replacement = Arc::new(b"%PDF-1.7\nother".to_vec());
+    assert_ne!(Arc::as_ptr(&replacement), address, "the entry pins the old header address");
+    assert_eq!(cache.get(&replacement), None);
+    assert!(cache.entries.is_empty(), "dead entries are pruned");
+    // Capacity is a hard bound with least-recently-used eviction.
+    let live: Vec<Arc<Vec<u8>>> = (0..10u8).map(|n| Arc::new(vec![n; 8])).collect();
+    for bytes in &live {
+        cache.insert(bytes, *blake3::hash(bytes).as_bytes());
+        assert!(cache.entries.len() <= 4);
+    }
+    assert!(live[..6].iter().all(|bytes| cache.get(bytes).is_none()));
+    assert!(live[6..].iter().all(|bytes| cache.get(bytes) == Some(*blake3::hash(bytes).as_bytes())));
+    assert!(live.iter().all(|bytes| Arc::strong_count(bytes) == 1));
+    let mut disabled = NativeDigests::new(0);
+    disabled.insert(&live[0], [0; 32]);
+    assert!(disabled.entries.is_empty());
+}
+
+/// Commands edit sources copy-on-write. The cache keys by allocation, so it is only sound if a
+/// remembered allocation can never be changed in place. A live `Weak` guarantees that:
+/// `Arc::get_mut` refuses and `Arc::make_mut` moves the bytes to a new allocation (a miss), both
+/// for a uniquely held source and for one shared with another document. Lookups also refresh
+/// recency, so a source in active use is not evicted by newer one-off reads.
+#[test]
+fn native_digest_cache_misses_after_copy_on_write_and_keeps_recently_used_sources() {
+    let mut cache = NativeDigests::new(2);
+    let mut unique = Arc::new(b"%PDF-1.7\nunique".to_vec());
+    let before = *blake3::hash(&unique).as_bytes();
+    cache.insert(&unique, before);
+    assert!(Arc::get_mut(&mut unique).is_none(), "a remembered allocation cannot be edited in place");
+    let old_address = Arc::as_ptr(&unique);
+    Arc::make_mut(&mut unique).extend_from_slice(b" edited");
+    assert_ne!(Arc::as_ptr(&unique), old_address, "copy-on-write moved the edited bytes");
+    assert_eq!(cache.get(&unique), None, "the edited source must be hashed again");
+    // The entry for the old allocation is dead (its bytes are gone) and is pruned.
+    assert!(cache.entries.is_empty());
+    let mut shared = Arc::new(b"%PDF-1.7\nshared".to_vec());
+    let other_document = Arc::clone(&shared);
+    let digest = *blake3::hash(&shared).as_bytes();
+    cache.insert(&shared, digest);
+    Arc::make_mut(&mut shared).push(b'!');
+    assert_eq!(cache.get(&shared), None);
+    assert_eq!(cache.get(&other_document), Some(digest), "the untouched copy keeps its digest");
+    assert_eq!(Arc::strong_count(&other_document), 1, "only the other document owns it");
+    // Recency: `get` moves an entry to the back, so the next insert evicts the other one.
+    let newer = Arc::new(vec![1u8; 4]);
+    cache.insert(&newer, [1; 32]);
+    assert_eq!(cache.get(&other_document), Some(digest));
+    let newest = Arc::new(vec![2u8; 4]);
+    cache.insert(&newest, [2; 32]);
+    assert_eq!(cache.get(&other_document), Some(digest), "a recently read source survives eviction");
+    assert_eq!(cache.get(&newer), None, "the least recently used entry was evicted");
+    // A remembered source's buffer is released with its last owner: only a dead Weak remains.
+    let weak = Arc::downgrade(&newest);
+    drop(newest);
+    assert!(weak.upgrade().is_none());
+}
