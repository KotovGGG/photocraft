diff --git a/docs/images/multi-channel-editing/cmyk-script.json b/docs/images/multi-channel-editing/cmyk-script.json
new file mode 100644
index 000000000..fb489c110
--- /dev/null
+++ b/docs/images/multi-channel-editing/cmyk-script.json
@@ -0,0 +1,47 @@
+[
+  [
+    "engine.execute",
+    {
+      "command": "image.imageSize",
+      "params": {
+        "width": 1000,
+        "resample": "bicubic"
+      }
+    }
+  ],
+  [
+    "engine.execute",
+    {
+      "command": "image.mode.cmyk",
+      "params": {}
+    }
+  ],
+  [
+    "engine.execute",
+    {
+      "command": "channel.target",
+      "params": {
+        "colors": [
+          0,
+          1,
+          2
+        ]
+      }
+    }
+  ],
+  [
+    "ui.set",
+    {
+      "dockTabs": {
+        "layers": 1
+      },
+      "fit": true
+    }
+  ],
+  [
+    "ui.menu.invoke",
+    {
+      "id": "image.adjustments.curves"
+    }
+  ]
+]
