+                let SmartSource::Linked { path } = &sm.source else { panic!("expected the PSD embedded-file table") };
+                assert_eq!(crate::linked::embedded_payload(&back.metadata, path).unwrap().1, source.as_slice(), "original native bytes changed");
+            }
+            back
+        };
