+        app.run("select.deselect", json!({})).unwrap();
+        match case {
+            "mask" => drop(app.run("layer.layerMask.revealAll", json!({})).unwrap()),
+            "alpha" => {
+                app.run("channel.new", json!({"fill": "black"})).unwrap();
+                app.run("channel.target", json!({"channel": 0})).unwrap();
