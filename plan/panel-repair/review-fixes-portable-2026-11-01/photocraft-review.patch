+                for y in 0..24 {
+                    for x in 0..32 {
+                        for k in 0..actual.channels() {
+                            let want = if target == "pixels" || k == 1 { &expected } else { &before };
+                            assert_eq!(
+                                actual.sample_channel(x, y, k).to_bits(),
+                                want.sample_channel(x, y, k).to_bits(),
+                                "{mode}@{depth} {target} component {k}"
