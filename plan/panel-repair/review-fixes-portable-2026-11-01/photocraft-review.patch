+        let swapped = o >= 5;
+        assert_eq!(up.dimensions(), if swapped { (H, W) } else { (W, H) }, "orientation {o}");
+        assert_eq!(up.meta.dpi, Some(if swapped { (150.0, 300.0) } else { (300.0, 150.0) }), "orientation {o}");
+    }
+}
