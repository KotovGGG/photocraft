+#[test]
+fn every_orientation_matches() {
+    let n = (W * H) as usize;
+    for o in 1..=8u64 {
+        let dir = strips(W, H, 8, 3, 2, 3, &noise(n * 3, 20 + o as u32))
+            .tag(274, SHORT, &[o])
+            .tag(282, RATIONAL, &[rational(300)])
+            .tag(283, RATIONAL, &[rational(150)])
+            .tag(296, SHORT, &[2]);
+        let bytes = build(true, false, &[dir], &[0]).bytes;
