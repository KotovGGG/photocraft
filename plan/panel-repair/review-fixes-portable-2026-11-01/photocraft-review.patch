diff --git a/docs/images/multi-channel-editing/gallery-channel-preview-script.json b/docs/images/multi-channel-editing/gallery-channel-preview-script.json
new file mode 100644
index 000000000..ef1cb026c
--- /dev/null
+++ b/docs/images/multi-channel-editing/gallery-channel-preview-script.json
@@ -0,0 +1,51 @@
+[
+  [
+    "engine.execute",
+    {
+      "command": "image.imageSize",
+      "params": {
+        "width": 1000,
+        "resample": "bicubic"
+      }
+    }
+  ],
+  [
+    "engine.execute",
+    {
+      "command": "channel.target",
+      "params": {
+        "colors": [
+          0,
+          2
+        ]
+      }
+    }
+  ],
+  [
+    "engine.execute",
+    {
+      "command": "channel.setVisible",
+      "params": {
+        "channel": "composite",
+        "visible": true
+      }
+    }
+  ],
+  [
+    "ui.menu.invoke",
+    {
+      "id": "filter.filterGallery"
+    }
+  ],
+  [
+    "ui.menu.invoke",
+    {
+      "id": "filter.filterGallery",
+      "params": {
+        "ui": {
+          "filter": "cutout"
+        }
+      }
+    }
+  ]
+]
