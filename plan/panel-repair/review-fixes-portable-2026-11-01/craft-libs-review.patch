+#[test]
+fn host_owned_surfaces_record_fitted_float_geometry() {
+    let mut host = Host { exclusive: true, ..Default::default() };
+    let layout = Layout { root: Some(Node::Tabs { panels: vec![1, 2], active: 0 }), floating: vec![] };
